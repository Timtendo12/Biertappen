{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "php artisan ziggy:generate --types=resources/js/types/ziggy.d.ts && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "e2e:prepare": "php artisan migrate:fresh --seed --force --env=e2e",
        "test:e2e": "npm run build && npm run e2e:prepare && playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.5.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.0",
        "concurrently": "^10.0.3",
        "happy-dom": "^20.14.5",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@tiptap/core": "^3.31.3",
        "@tiptap/extension-document": "^3.31.3",
        "@tiptap/extension-paragraph": "^3.31.3",
        "@tiptap/extension-placeholder": "^3.31.3",
        "@tiptap/extension-text": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/vue-3": "^3.31.3",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10",
        "ziggy-js": "^2.6.4"
    }
}
